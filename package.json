{
  "name": "agent-diff-tracker",
  "displayName": "Agent Diff Tracker",
  "description": "Automatically shows a diff view of the files your AI coding agent just changed, with a scrollable history sidebar, so you can watch what it's doing in real time.",
  "version": "0.4.0",
  "publisher": "JoaquinTelleria",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/highnet/agent-diff-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/highnet/agent-diff-tracker/issues"
  },
  "homepage": "https://github.com/highnet/agent-diff-tracker#readme",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#141924",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "diff",
    "git",
    "copilot",
    "cursor",
    "claude"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentDiffTracker.toggle",
        "title": "Agent Diff Tracker: Toggle Watching"
      },
      {
        "command": "agentDiffTracker.showLatest",
        "title": "Agent Diff Tracker: Show Latest Changed File Diff"
      },
      {
        "command": "agentDiffTracker.clearHistory",
        "title": "Agent Diff Tracker: Clear History",
        "icon": "$(clear-all)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentDiffTracker",
          "title": "Agent Diff Tracker",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "agentDiffTracker": [
        {
          "id": "agentDiffTracker.history",
          "name": "Change History"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentDiffTracker.history",
        "contents": "No changes seen yet.\nWhen your AI agent — or anything else — edits a file in this workspace, it shows up here and its diff opens automatically.\nUse the eye item in the status bar (bottom right) to pause or resume watching."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentDiffTracker.clearHistory",
          "when": "view == agentDiffTracker.history",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Agent Diff Tracker",
      "properties": {
        "agentDiffTracker.debounceMs": {
          "type": "number",
          "default": 400,
          "description": "Milliseconds to wait after a file change before opening its diff. Multiple files that change within this window are treated as one batch."
        },
        "agentDiffTracker.exclude": {
          "type": "array",
          "default": [
            "**/.git/**",
            "**/node_modules/**",
            "**/bower_components/**",
            "**/dist/**",
            "**/build/**",
            "**/out/**",
            "**/.next/**",
            "**/.nuxt/**",
            "**/.svelte-kit/**",
            "**/.output/**",
            "**/.vercel/**",
            "**/.netlify/**",
            "**/.turbo/**",
            "**/.parcel-cache/**",
            "**/.cache/**",
            "**/.rollup.cache/**",
            "**/.webpack/**",
            "**/coverage/**",
            "**/.nyc_output/**",
            "**/.eslintcache",
            "**/.stylelintcache",
            "**/.sass-cache/**",
            "**/__pycache__/**",
            "**/.venv/**",
            "**/venv/**",
            "**/env/**",
            "**/.tox/**",
            "**/.mypy_cache/**",
            "**/.pytest_cache/**",
            "**/.ruff_cache/**",
            "**/.eggs/**",
            "**/*.egg-info/**",
            "**/site-packages/**",
            "**/target/**",
            "**/.gradle/**",
            "**/.m2/**",
            "**/*.class",
            "**/vendor/**",
            "**/vendor/bundle/**",
            "**/.bundle/**",
            "**/log/**",
            "**/tmp/**",
            "**/bin/**",
            "**/obj/**",
            "**/packages/**",
            "**/*.suo",
            "**/*.user",
            "**/cmake-build-*/**",
            "**/*.o",
            "**/*.obj",
            "**/.build/**",
            "**/DerivedData/**",
            "**/Pods/**",
            "**/*.xcuserstate",
            "**/xcuserdata/**",
            "**/_build/**",
            "**/deps/**",
            "**/.terraform/**",
            "**/*.tfstate",
            "**/*.tfstate.backup",
            "**/.idea/**",
            "**/*.iml",
            "**/.fleet/**",
            "**/.history/**",
            "**/graphify-out/**",
            "**/.DS_Store",
            "**/Thumbs.db",
            "**/desktop.ini",
            "**/*.tsbuildinfo",
            "**/*.log",
            "**/*.pyc",
            "**/*.pdb"
          ],
          "description": "Glob patterns to ignore when watching for changes. Covers common build/cache/dependency directories across Node, Python, Java/Kotlin, Go, Rust, Ruby, PHP, .NET, Swift/Xcode, Elixir, Terraform, plus editor and OS cruft. .git, node_modules, .next, .impeccable, dist, out, and build are always excluded regardless of this setting."
        },
        "agentDiffTracker.preserveFocus": {
          "type": "boolean",
          "default": true,
          "description": "When true, the diff tab opens without stealing editor focus from where you're typing."
        },
        "agentDiffTracker.minBurstFilesToAutoOpen": {
          "type": "number",
          "default": 1,
          "description": "Minimum number of files that must change together (within debounceMs) before a diff is auto-opened. Set to 2+ to ignore lone manual edits and only react to agent-style bursts; changes below the threshold still appear in the History view."
        },
        "agentDiffTracker.maxAutoOpenFiles": {
          "type": "number",
          "default": 4,
          "description": "Maximum number of diff tabs to auto-open at once for a single batch of changes. Remaining files are still recorded in the History view."
        },
        "agentDiffTracker.maxHistoryEntries": {
          "type": "number",
          "default": 50,
          "description": "Maximum number of change bursts kept in the Change History sidebar."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "reinstall": "bash ./scripts/reinstall.sh",
    "test:unit": "mocha --config .mocharc-unit.json",
    "pretest:integration": "tsc -p ./tsconfig.test.json",
    "test:integration": "node ./out-test/test/integration/runTests.js",
    "test": "npm run test:unit && npm run test:integration"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.0.0",
    "glob": "^13.0.6",
    "mocha": "^11.7.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
